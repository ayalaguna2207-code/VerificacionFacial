<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="20dp"
            android:contentDescription="Logo ValidaID" android:src="@drawable/ic_logo" />
        <TextView android:id="@+id/tvBienvenida" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center" android:textColor="@color/verif_primario"
            android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvEstadoRostro" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="14dp" android:gravity="center" android:textSize="15sp" />
        <TextView android:id="@+id/tvUmbralActual" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="22dp" android:gravity="center" android:textColor="#546E7A" android:textSize="13sp" />
        <Button android:id="@+id/btnVerificar" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="Verificar mi identidad" android:textSize="18sp" />
        <Button android:id="@+id/btnResultados" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
            android:text="Pruebas y resultados" />
        <Button android:id="@+id/btnMiCuenta" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
            android:text="Mi cuenta" />
        <Button android:id="@+id/btnCerrarSesion" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:text="Cerrar sesión" />
    </LinearLayout>
</ScrollView>
